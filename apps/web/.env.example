# Frontend (Vite) — public/publishable values only.
# Copy this file to .env and fill from Dashboard / MCP get_publishable_keys.
# Never commit real keys. Never put the service-role key here.

# Smart Base Binary — ref wkfyavcjjuyzvyeprklz
VITE_SUPABASE_URL=https://wkfyavcjjuyzvyeprklz.supabase.co
# Prefer either publishable OR anon (client uses publishable first, then anon):
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# REAL market data — prefer Deriv public WebSocket for digit contracts.
# Leave unset to keep REAL market data NOT CONFIGURED.
# Provider: deriv (default for digit EVEN/ODD · MATCH/DIFFER · OVER/UNDER) | binance
VITE_MARKET_DATA_PROVIDER=deriv
VITE_DERIV_APP_ID=1089
VITE_MARKET_DATA_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# Optional legacy Binance public feed (charts only; weaker for digit contracts):
# VITE_MARKET_DATA_PROVIDER=binance
# VITE_MARKET_DATA_API_URL=http://localhost:3001
# VITE_MARKET_DATA_WS_URL=wss://stream.binance.com:9443

# Optional: enable ONLY for local Playwright verify-ui (dev server). Never set in production.
# Ignored by production builds (guarded by import.meta.env.DEV) and forced false in .env.production.
# VITE_E2E_AUTH_BYPASS=true

# Production build (optionmarkettraders.com) needs: VITE_SUPABASE_URL,
# VITE_SUPABASE_PUBLISHABLE_KEY (or VITE_SUPABASE_ANON_KEY), VITE_MARKET_DATA_PROVIDER,
# VITE_DERIV_APP_ID, VITE_MARKET_DATA_WS_URL. All are public and baked into the bundle.

# Notes:
# - Deriv public test app_id allows ticks_history; ticks streaming may return InvalidSymbol.
#   The client falls back to polling genuine history snapshots for live quotes.
# - Never put service-role or Deriv trading tokens in VITE_* vars.
