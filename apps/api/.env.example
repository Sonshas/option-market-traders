# Backend (Express) — server-only values.
# Copy this file to .env and replace placeholders. Never commit real keys.
# Never send SUPABASE_SERVICE_ROLE_KEY to the browser.

PORT=3001
CORS_ORIGIN=http://localhost:5173
# Production (Vultr VPS behind Caddy):
# CORS_ORIGIN=https://optionmarkettraders.com,https://www.optionmarkettraders.com

# Selected empty project (schema applied): Smart Base Binary
# Ref: wkfyavcjjuyzvyeprklz — service role is server-only; never expose to the browser.
SUPABASE_URL=https://wkfyavcjjuyzvyeprklz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# REAL market data proxy (Binance public REST — no API key required)
MARKET_DATA_PROVIDER=binance
MARKET_DATA_REST_URL=https://api.binance.com
